{
  "name": "jeweltrackerpro",
  "private": true,
  "version": "1.0.0",
  "description": "JewelTrackerPro billing and inventory",
  "author": "JewelTrackerPro",
  "productName": "JewelTrackerPro",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch --tsconfig tsconfig.server.json server/index.ts\"",
    "server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --tsconfig tsconfig.server.json server/index.ts",
    "lint": "eslint .",
    "test:integration": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:electron-e2e": "playwright test --config playwright.electron.config.ts",
    "test": "npm run test:integration && npm run test:e2e",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/build-electron.mjs && concurrently -k \"vite\" \"electron . -- --dev\"",
    "electron:rebuild": "electron-builder install-app-deps",
    "electron:pack": "npm run build && npm run build:electron && electron-builder --config electron-builder.config.cjs --dir",
    "electron:build": "npm run build && npm run build:electron && electron-builder --config electron-builder.config.cjs",
    "electron:build:mac": "npm run build && npm run build:electron && electron-builder --config electron-builder.config.cjs --mac",
    "electron:build:win": "npm run build && npm run build:electron && electron-builder --config electron-builder.config.cjs --win",
    "rebuild:native": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^1.48.0",
    "multer": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9"
  }
}
