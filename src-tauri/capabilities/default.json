{
  "identifier": "default",
  "description": "Desktop capabilities for JewelTrackerPro",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-save",
    "desktop-commands",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "name": "binaries/jeweltrackerpro-api",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "args": true,
          "name": "binaries/jeweltrackerpro-api",
          "sidecar": true
        }
      ]
    }
  ]
}
